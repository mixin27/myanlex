{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myanlex.org/schema/encoding-detection.schema.json",
  "title": "MyanLex Myanmar encoding-detection corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "profile",
    "model",
    "thresholds",
    "description",
    "license",
    "sources",
    "derivation",
    "review_status",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "profile": { "const": "zawgyi-unicode-v1" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "google-myanmar-tools" },
        "version": { "const": "1.2.0" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unicode_max_probability", "zawgyi_min_probability"],
      "properties": {
        "unicode_max_probability": { "const": 0.05 },
        "zawgyi_min_probability": { "const": 0.95 }
      }
    },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "derivation": { "type": "string", "minLength": 1 },
    "review_status": {
      "enum": ["draft", "source_verified", "linguistically_reviewed"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "encoding", "segments", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "input": { "type": "string" },
          "encoding": {
            "enum": ["unicode", "zawgyi", "mixed", "unknown", "non_myanmar"]
          },
          "basis": { "type": "string", "minLength": 1 },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "encoding", "start", "end"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "encoding": { "enum": ["unicode", "zawgyi", "unknown"] },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
