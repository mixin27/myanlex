{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myanlex.org/schema/normalization.schema.json",
  "title": "MyanLex normalization corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "unicode_version",
    "profile",
    "description",
    "license",
    "sources",
    "derivation",
    "review_status",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "unicode_version": { "const": "17.0.0" },
    "profile": { "const": "unicode-nfc" },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "derivation": { "type": "string", "minLength": 1 },
    "review_status": {
      "enum": ["draft", "source_verified", "linguistically_reviewed"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected", "changed", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "input": { "type": "string" },
          "expected": { "type": "string" },
          "changed": { "type": "boolean" },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
