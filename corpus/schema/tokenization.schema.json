{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myanlex.org/schema/tokenization.schema.json",
  "title": "MyanLex tokenization corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "unicode_version",
    "profile",
    "description",
    "license",
    "sources",
    "derivation",
    "review_status",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "unicode_version": { "const": "17.0.0" },
    "profile": { "const": "myanmar-script-tokens-v1" },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "derivation": { "type": "string", "minLength": 1 },
    "review_status": {
      "enum": ["draft", "source_verified", "linguistically_reviewed"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "basis", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "input": { "type": "string" },
          "basis": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tokens", "scripts", "mixedScript"],
            "properties": {
              "tokens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "text", "script", "start", "end"],
                  "properties": {
                    "kind": {
                      "enum": [
                        "burmese_syllable",
                        "latin_word",
                        "number",
                        "punctuation",
                        "whitespace",
                        "emoji",
                        "unsupported_myanmar",
                        "other"
                      ]
                    },
                    "text": { "type": "string", "minLength": 1 },
                    "script": {
                      "enum": ["myanmar", "latin", "common", "unknown"]
                    },
                    "start": { "type": "integer", "minimum": 0 },
                    "end": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              "scripts": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["myanmar", "latin"] }
              },
              "mixedScript": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
