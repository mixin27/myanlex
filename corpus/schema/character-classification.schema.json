{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myanlex.org/schema/character-classification.schema.json",
  "title": "MyanLex character-classification corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unicode_version",
    "description",
    "license",
    "source",
    "source_sha256",
    "derivation",
    "review_status",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "unicode_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "format": "uri" },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "derivation": { "type": "string", "minLength": 1 },
    "review_status": {
      "enum": ["draft", "source_verified", "linguistically_reviewed"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "character", "code_point", "expected", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "character": { "type": "string", "minLength": 1 },
          "code_point": {
            "type": "string",
            "pattern": "^U\\+[0-9A-F]{4,6}$"
          },
          "expected": {
            "enum": [
              "myanmar_letter",
              "myanmar_vowel_sign",
              "myanmar_medial",
              "myanmar_tone_mark",
              "myanmar_asat",
              "myanmar_virama",
              "myanmar_mark",
              "myanmar_digit",
              "myanmar_punctuation",
              "myanmar_symbol",
              "ascii_latin_letter",
              "ascii_digit",
              "ascii_punctuation",
              "whitespace",
              "other"
            ]
          },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
