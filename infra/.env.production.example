# MyanLex production environment for infra/compose.production.yaml.
# Paste into Dokploy -> your Compose app -> Environment, then replace every
# placeholder. Never commit real values. Generate secrets with:
#   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
# Runbook: docs/dokploy-runbook.md

# --- Release ---------------------------------------------------------------
# GitHub owner of the images, lower case (ghcr.io/<owner>/myanlex-*).
GHCR_OWNER=your-github-user
# "production" (moved by the deploy workflow) or "production-sha-<7>" to pin.
IMAGE_TAG=production
# "production" or "staging" (a second Dokploy app on the same server).
STACK_NAME=production

# --- PostgreSQL (container in the stack) ----------------------------------
POSTGRES_USER=myanlex
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=myanlex

# --- Accounts and sign-in --------------------------------------------------
# At least 32 random characters. Rotating it signs everyone out.
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# The console's public origin: https, no trailing slash.
AUTH_PUBLIC_URL=https://console.example.com
# Optional OAuth; set both values of a pair or neither. Callback URLs:
#   https://console.example.com/api/auth/callback/google (and /github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (Resend SMTP, or any provider) ---------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_THE_SMTP_API_KEY
# A plain address on a domain verified with the provider.
SMTP_FROM=no-reply@example.com

# --- Billing ---------------------------------------------------------------
# Shown on invoices, emails and the portal (bank details, how to reference).
MYANLEX_BILLING_PAYMENT_INSTRUCTIONS=Bank transfer to ... Include the invoice number.
# Optional: an operator address told about new plan change requests.
MYANLEX_BILLING_NOTIFY_EMAIL=

# --- Operations ------------------------------------------------------------
# Bearer token for /internal/metrics (32+ letters, digits, _ or -).
MYANLEX_METRICS_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_TOKEN
# Proxies allowed to set the client address: the Docker network Traefik runs
# on plus Cloudflare's ranges (https://www.cloudflare.com/ips/). See the
# runbook; leave false until Traefik is configured to pass them through.
MYANLEX_TRUST_PROXY=false
MYANLEX_RATE_LIMIT_MAX=60
MYANLEX_USAGE_RETENTION_MONTHS=13
MYANLEX_AUDIT_RETENTION_DAYS=365
# Healthchecks.io check URL for the daily run (schedule: daily, grace 1h).
MYANLEX_HEARTBEAT_URL=https://hc-ping.com/REPLACE_WITH_YOUR_CHECK_UUID
# Optional second check for the 15-minute usage alerts (period 15 min, grace 30 min).
MYANLEX_USAGE_ALERTS_HEARTBEAT_URL=

# --- Backups (Cloudflare R2, private bucket, token scoped to it) ----------
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=myanlex-production-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=REPLACE
BACKUP_S3_SECRET_ACCESS_KEY=REPLACE
BACKUP_S3_PREFIX=postgres
BACKUP_RETENTION_DAYS=14
