{
  "name": "@myanlex/core",
  "version": "0.0.0",
  "description": "Framework-independent Myanmar language processing core",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@myanlex/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixin27/myanlex.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mixin27/myanlex/issues"
  },
  "homepage": "https://github.com/mixin27/myanlex/tree/main/packages/core#readme",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
