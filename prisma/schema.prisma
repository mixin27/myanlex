generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  email                  String                   @unique @db.VarChar(320)
  /// Legacy only. Better Auth credential hashes are stored in Account.password.
  passwordHash           String?                  @map("password_hash")
  name                   String                   @db.VarChar(120)
  /// Legacy only. Runtime verification uses emailVerified, not this timestamp.
  emailVerifiedAt        DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships            OrganizationMember[]
  emailVerified          Boolean                  @default(false) @map("email_verified")
  image                  String?
  sessions               Session[]
  accounts               Account[]
  playgroundRuns         PlaygroundRun[]
  invitationsSent        OrganizationInvitation[] @relation("InvitationInviter")
  invitationsUsed        OrganizationInvitation[] @relation("InvitationAcceptor")
  billingProfilesUpdated BillingProfile[]         @relation("BillingProfileUpdater")
  billingEmailsAdded     BillingEmail[]           @relation("BillingEmailCreator")
  auditEvents            AuditEvent[]
  planChanges            PlanChange[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

model Organization {
  id             String                   @id @default(uuid()) @db.Uuid
  name           String                   @db.VarChar(120)
  slug           String                   @unique @db.VarChar(80)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  members        OrganizationMember[]
  roles          Role[]
  projects       Project[]
  subscriptions  Subscription[]
  quotas         OrganizationQuota[]
  invitations    OrganizationInvitation[]
  auditEvents    AuditEvent[]
  usageEvents    UsageEvent[]
  statements     UsageStatement[]
  planChanges    PlanChange[]
  invoices       Invoice[]
  billingProfile BillingProfile?
  billingEmails  BillingEmail[]
  usageAlerts    UsageAlert[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([organizationId, userId])
  @@index([userId])
  @@index([roleId, organizationId])
  @@map("organization_members")
}

model Role {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  name           String                   @db.VarChar(80)
  slug           String                   @db.VarChar(80)
  description    String?
  /// System roles (Owner) keep the full permission catalog and cannot be edited.
  system         Boolean                  @default(false)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  permissions    RolePermission[]
  invitations    OrganizationInvitation[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@map("roles")
}

/// Only a SHA-256 hash of the single-use invitation token is stored. The
/// migration adds a partial unique index for one open invitation per email.
model OrganizationInvitation {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  email            String       @db.VarChar(320)
  roleId           String       @map("role_id") @db.Uuid
  tokenHash        String       @unique @map("token_hash") @db.Char(64)
  invitedByUserId  String?      @map("invited_by_user_id") @db.Uuid
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?    @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?      @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role             Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitedBy        User?        @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy       User?        @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, id])
  @@index([email, expiresAt])
  @@index([roleId, organizationId])
  @@map("organization_invitations")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       RolePermission[]
  apiKeys     ApiKeyScope[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String          @db.VarChar(120)
  slug           String          @db.VarChar(80)
  environment    String          @default("development") @db.VarChar(40)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]
  usage          ApiUsage[]
  usageEvents    UsageEvent[]
  playgroundRuns PlaygroundRun[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

model ApiKey {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  name        String        @db.VarChar(120)
  prefix      String        @db.VarChar(24)
  keyHash     String        @unique @map("key_hash") @db.Char(64)
  lastUsedAt  DateTime?     @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopes      ApiKeyScope[]
  usage       ApiUsage[]
  usageEvents UsageEvent[]

  @@index([projectId])
  @@index([prefix])
  @@map("api_keys")
}

model ApiKeyScope {
  apiKeyId     String     @map("api_key_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  apiKey       ApiKey     @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([apiKeyId, permissionId])
  @@index([permissionId])
  @@map("api_key_scopes")
}

model ApiUsage {
  id                  BigInt   @id @default(autoincrement())
  projectId           String   @map("project_id") @db.Uuid
  apiKeyId            String?  @map("api_key_id") @db.Uuid
  source              String   @default("api_key") @db.VarChar(24)
  endpoint            String   @db.VarChar(160)
  statusCode          Int      @map("status_code") @db.SmallInt
  requestUnits        Int      @default(1) @map("request_units")
  charactersProcessed Int      @default(0) @map("characters_processed")
  processingTimeMs    Int      @map("processing_time_ms")
  /// The billable ledger entry this diagnostic record describes, if any.
  usageEventId        String?  @map("usage_event_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKey              ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([apiKeyId, createdAt])
  @@map("api_usage")
}

model PlaygroundRun {
  id          String   @id @db.Uuid
  creatorId   String   @map("creator_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  title       String   @db.VarChar(120)
  snapshot    String   @db.Text
  contentHash String   @map("content_hash") @db.Char(64)
  payloadSize Int      @map("payload_size")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([creatorId, expiresAt])
  @@index([projectId, creatorId, id])
  @@index([expiresAt])
  @@map("playground_runs")
}

model Plan {
  id                       String         @id @default(uuid()) @db.Uuid
  name                     String         @db.VarChar(80)
  slug                     String         @unique @db.VarChar(80)
  monthlyRequestLimit      BigInt?        @map("monthly_request_limit")
  monthlyCharacterLimit    BigInt?        @map("monthly_character_limit")
  /// ISO 4217 code; every amount on the plan is in this currency's minor units.
  currency                 String         @default("MMK") @db.Char(3)
  baseFeeMinor             BigInt         @default(0) @map("base_fee_minor")
  /// `block` denies at the allowance; `allow` bills overage up to the ceilings.
  overageMode              String         @default("block") @map("overage_mode") @db.VarChar(16)
  requestBlock             BigInt         @default(1000) @map("request_block")
  requestBlockPriceMinor   BigInt         @default(0) @map("request_block_price_minor")
  characterBlock           BigInt         @default(100000) @map("character_block")
  characterBlockPriceMinor BigInt         @default(0) @map("character_block_price_minor")
  requestCeiling           BigInt?        @map("request_ceiling")
  characterCeiling         BigInt?        @map("character_ceiling")
  public                   Boolean        @default(false)
  description              String?        @db.VarChar(500)
  archivedAt               DateTime?      @map("archived_at") @db.Timestamptz(3)
  /// `approval` (operator reviews) or `self_service` (checkout, once a payment provider exists).
  changePolicy             String         @default("approval") @map("change_policy") @db.VarChar(16)
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions            Subscription[]
  planChanges              PlanChange[]

  @@map("plans")
}

model Subscription {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  planId         String       @map("plan_id") @db.Uuid
  status         String       @db.VarChar(40)
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?    @map("ends_at") @db.Timestamptz(3)
  assignedBy     String?      @map("assigned_by") @db.VarChar(320)
  note           String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  planChanges PlanChange[]

  @@index([organizationId, status])
  @@index([planId])
  @@map("subscriptions")
}

model OrganizationQuota {
  organizationId String       @map("organization_id") @db.Uuid
  monthStart     DateTime     @map("month_start") @db.Timestamptz(3)
  requestCount   BigInt       @default(0) @map("request_count")
  characterCount BigInt       @default(0) @map("character_count")
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, monthStart])
  @@map("organization_quotas")
}

/// Append-only record of administrative changes. Rows are written in the same
/// transaction as the change they describe; UPDATE is rejected by a trigger.
model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// Null once the acting user is deleted; actorEmail keeps the snapshot.
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  actorEmail     String       @map("actor_email") @db.VarChar(320)
  action         String       @db.VarChar(64)
  targetType     String       @map("target_type") @db.VarChar(32)
  targetId       String       @map("target_id")
  metadata       Json         @default("{}")
  requestId      String?      @map("request_id") @db.VarChar(128)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_events")
}

/// Billable usage ledger: one row per admitted API-key request, written in the
/// same transaction as the quota counter. UPDATE is rejected by a trigger.
model UsageEvent {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  /// Null for portal playground runs, which reserve the same organization quota.
  apiKeyId       String?      @map("api_key_id") @db.Uuid
  source         String       @db.VarChar(24)
  monthStart     DateTime     @map("month_start") @db.Timestamptz(3)
  requestUnits   Int          @default(1) @map("request_units")
  characters     BigInt
  endpoint       String       @db.VarChar(160)
  requestId      String?      @map("request_id") @db.VarChar(128)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([organizationId, monthStart, createdAt, id])
  @@index([organizationId, monthStart, projectId, apiKeyId])
  @@index([monthStart])
  @@index([projectId])
  @@index([apiKeyId])
  @@map("usage_events")
}

/// Closed monthly totals. Immutable once written by `pnpm usage:close-month`.
model UsageStatement {
  organizationId    String       @map("organization_id") @db.Uuid
  monthStart        DateTime     @map("month_start") @db.Timestamptz(3)
  requestCount      BigInt       @map("request_count")
  characterCount    BigInt       @map("character_count")
  eventCount        BigInt       @map("event_count")
  counterRequests   BigInt       @map("counter_requests")
  counterCharacters BigInt       @map("counter_characters")
  reconciled        Boolean
  plan              Json
  breakdown         Json
  /// Priced charges; null for months closed before plan pricing existed.
  charges           Json?
  closedAt          DateTime     @default(now()) @map("closed_at") @db.Timestamptz(3)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, monthStart])
  @@index([monthStart])
  @@map("usage_statements")
}

/// A requested plan change, whatever its channel. See docs/decisions/0025.
model PlanChange {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  fromPlanSlug      String        @map("from_plan_slug") @db.VarChar(80)
  planId            String        @map("plan_id") @db.Uuid
  /// `approval` now; `checkout` once a payment provider exists.
  channel           String        @db.VarChar(16)
  /// `now` (on approval or payment) or `next_month`.
  timing            String        @db.VarChar(16)
  requestedStartsAt DateTime?     @map("requested_starts_at") @db.Timestamptz(3)
  note              String?       @db.VarChar(500)
  requesterUserId   String?       @map("requester_user_id") @db.Uuid
  requesterEmail    String        @map("requester_email") @db.VarChar(320)
  /// pending | awaiting_payment (open); applied | rejected | cancelled | expired.
  status            String        @db.VarChar(24)
  decidedAt         DateTime?     @map("decided_at") @db.Timestamptz(3)
  decidedBy         String?       @map("decided_by") @db.VarChar(320)
  decisionNote      String?       @map("decision_note") @db.VarChar(500)
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  /// A future payment provider's checkout or session id.
  externalRef       String?       @map("external_ref") @db.VarChar(200)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  requester         User?         @relation(fields: [requesterUserId], references: [id], onDelete: SetNull)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoices          Invoice[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([planId])
  @@index([requesterUserId])
  @@index([subscriptionId])
  @@map("plan_changes")
}

/// Next invoice number per year (gap-free; taken under a row lock). ADR 0026.
model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("invoice_sequences")
}

/// A MyanLex-issued invoice: prepaid base fees and overage in arrears (ADR 0026).
/// Lines and amounts are immutable once issued; only status, payment and void fields change.
model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  number           String        @unique @db.VarChar(32)
  organizationId   String        @map("organization_id") @db.Uuid
  /// `monthly` (base fee for the month + previous month's overage) or `proration`.
  kind             String        @db.VarChar(16)
  periodStart      DateTime      @map("period_start") @db.Timestamptz(3)
  periodEnd        DateTime      @map("period_end") @db.Timestamptz(3)
  currency         String        @db.Char(3)
  subtotalMinor    BigInt        @map("subtotal_minor")
  totalMinor       BigInt        @map("total_minor")
  /// open | paid | void
  status           String        @default("open") @db.VarChar(8)
  issuedAt         DateTime      @map("issued_at") @db.Timestamptz(3)
  dueAt            DateTime      @map("due_at") @db.Timestamptz(3)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason       String?       @map("void_reason") @db.VarChar(500)
  planChangeId     String?       @map("plan_change_id") @db.Uuid
  /// Set when dunning moved the workspace to Free; payment restores this plan.
  restoresPlanSlug String?       @map("restores_plan_slug") @db.VarChar(80)
  remindersSent    Int           @default(0) @map("reminders_sent")
  /// Bill-to details when issued ({ name, address, taxId, note }); immutable.
  billTo           Json?         @map("bill_to")
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planChange       PlanChange?   @relation(fields: [planChangeId], references: [id], onDelete: SetNull)
  lines            InvoiceLine[]
  payments         Payment[]

  @@index([organizationId, issuedAt(sort: Desc)])
  @@index([status, dueAt])
  @@index([planChangeId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  position    Int
  /// base_fee | proration | request_overage | character_overage
  kind        String  @db.VarChar(24)
  description String  @db.VarChar(300)
  quantity    BigInt
  unitMinor   BigInt  @map("unit_minor")
  amountMinor BigInt  @map("amount_minor")
  planSlug    String  @map("plan_slug") @db.VarChar(80)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@map("invoice_lines")
}

/// A payment settling an invoice in full. Provider callbacks are idempotent by (provider, external_ref).
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  /// bank_transfer | cash | provider
  method      String   @db.VarChar(16)
  provider    String?  @db.VarChar(32)
  externalRef String?  @map("external_ref") @db.VarChar(200)
  amountMinor BigInt   @map("amount_minor")
  currency    String   @db.Char(3)
  receivedAt  DateTime @map("received_at") @db.Timestamptz(3)
  recordedBy  String   @map("recorded_by") @db.VarChar(320)
  note        String?  @db.VarChar(500)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([provider, externalRef])
  @@index([invoiceId])
  @@map("payments")
}

/// Bill-to details printed on invoices issued after a change (ADR 0026).
model BillingProfile {
  organizationId  String       @id @map("organization_id") @db.Uuid
  legalName       String?      @map("legal_name") @db.VarChar(200)
  address         String?      @db.VarChar(500)
  taxId           String?      @map("tax_id") @db.VarChar(64)
  invoiceNote     String?      @map("invoice_note") @db.VarChar(500)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId String?      @map("updated_by_user_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy       User?        @relation("BillingProfileUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("billing_profiles")
}

/// Addresses that receive invoice mail once confirmed by link; at most three.
model BillingEmail {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  email           String       @db.VarChar(320)
  tokenHash       String?      @unique @map("token_hash") @db.Char(64)
  tokenExpiresAt  DateTime?    @map("token_expires_at") @db.Timestamptz(3)
  verifiedAt      DateTime?    @map("verified_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("BillingEmailCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@map("billing_emails")
}

/// A usage threshold crossed in a month, emailed once to billing contacts.
model UsageAlert {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  monthStart     DateTime     @map("month_start") @db.Timestamptz(3)
  /// allowance_80 | allowance_100 | ceiling_90
  kind           String       @db.VarChar(16)
  /// requests | characters
  dimension      String       @db.VarChar(16)
  used           BigInt
  thresholdValue BigInt       @map("threshold_value")
  limitValue     BigInt       @map("limit_value")
  planSlug       String       @map("plan_slug") @db.VarChar(80)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime?    @map("sent_at") @db.Timestamptz(3)
  attempts       Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, monthStart, kind])
  @@map("usage_alerts")
}
