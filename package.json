{
  "name": "myanlex",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source Myanmar-language processing tools",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "quality:report": "node scripts/nlp-quality.mjs",
    "quality:test": "node --test scripts/nlp-quality.test.mjs",
    "monitoring:check": "node scripts/monitoring-check.mjs",
    "staging:load": "node scripts/staging-load.mjs",
    "operations:test": "node --test scripts/staging-load.test.mjs",
    "operations:rehearsal": "pnpm --filter @myanlex/api... build && node scripts/operations-rehearsal.mjs",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "docs:smoke": "pnpm --filter @myanlex/api... build && tsx scripts/docs-smoke.mjs",
    "docs:site:smoke": "pnpm --filter @myanlex/docs build && node scripts/docs-site-smoke.mjs",
    "benchmark": "pnpm build && node --expose-gc benchmarks/application.mjs",
    "sdk:smoke": "pnpm --filter @myanlex/sdk... --filter @myanlex/api... build && node scripts/sdk-smoke.mjs",
    "dart:sdk:smoke": "pnpm --filter @myanlex/api... build && node scripts/dart-sdk-smoke.mjs",
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm openapi:lint && pnpm typecheck && pnpm test && pnpm operations:test && pnpm quality:test",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm --filter @myanlex/web lint && pnpm --filter @myanlex/docs lint",
    "openapi:lint": "redocly lint openapi/openapi.yaml --config redocly.yaml",
    "postinstall": "prisma generate",
    "pretypecheck": "pnpm db:generate",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --filter @myanlex/types build && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.53.3",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
