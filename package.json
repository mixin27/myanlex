{
  "name": "myanlex",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source Myanmar-language processing tools",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "benchmark": "pnpm build && node --expose-gc benchmarks/application.mjs",
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm openapi:lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "openapi:lint": "redocly lint openapi/openapi.yaml --config redocly.yaml",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --filter @myanlex/types build && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
