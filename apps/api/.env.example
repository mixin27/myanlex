# Use a long, random value outside local development.
MYANLEX_API_KEY=local-development-key

# Enable PostgreSQL-backed projects, API keys, RBAC, and usage records.
DATABASE_URL=postgresql://myanlex:myanlex@localhost:5432/myanlex?schema=public

# Optional values
PORT=3000
MYANLEX_VERSION=0.0.0
MYANLEX_RATE_LIMIT_MAX=60
MYANLEX_RATE_LIMIT_WINDOW_MS=60000
