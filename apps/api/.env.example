# Use a long, random value outside local development.
MYANLEX_API_KEY=local-development-key

# Enable PostgreSQL-backed projects, API keys, RBAC, and usage records.
DATABASE_URL=postgresql://myanlex:myanlex@localhost:5432/myanlex?schema=public

# Optional values
PORT=3000
MYANLEX_VERSION=0.0.0
MYANLEX_RATE_LIMIT_MAX=60
MYANLEX_RATE_LIMIT_WINDOW_MS=60000

# Optional shared rate limits. Required for multiple API replicas.
# Start with: docker compose --profile redis up -d
# REDIS_URL=redis://localhost:6379
MYANLEX_REDIS_PREFIX=myanlex
# Enable only after db:deploy and db:seed. Shared across each organization's keys/projects.
MYANLEX_QUOTAS_ENABLED=false

# Account authentication is optional for NLP-only deployments.
# For the portal, set PORT=3001 above and AUTH_ENABLED=true below.
AUTH_ENABLED=false
# Generate with: openssl rand -base64 48
# AUTH_SECRET=
AUTH_PUBLIC_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=auth@myanlex.local
# SMTP_USER=
# SMTP_PASSWORD=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
